{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "beauty-corner",
  "compatibility_date": "2026-07-25",
  "compatibility_flags": ["nodejs_compat"],
  // Temporarily enabled so the Worker is reachable while beautycorner.sa
  // stays on a different Cloudflare account/zone that this login cannot bind.
  "workers_dev": true,
  "preview_urls": true,
  // Never SPA-fallback unknown paths to index.html.
  // Keep assets-first so `public/_redirects` can 301 legacy WordPress URLs.
  // Misses then reach the Astro Worker (middleware + 404.astro).
  // html_handling drops trailing slashes for real *.html files.
  "assets": {
    "not_found_handling": "none",
    "html_handling": "drop-trailing-slash",
    "run_worker_first": false
  },
  "ratelimits": [
    {
      "name": "CUSTOMER_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "env": {
    "staging": {
      "workers_dev": true,
      "preview_urls": true,
      "ratelimits": [
        {
          "name": "CUSTOMER_RATE_LIMITER",
          "namespace_id": "1002",
          "simple": {
            "limit": 10,
            "period": 60
          }
        }
      ]
    }
  }
}
