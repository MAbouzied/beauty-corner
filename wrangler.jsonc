{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "beauty-corner",
  "compatibility_date": "2026-07-25",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "ratelimits": [
    {
      "name": "CUSTOMER_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "env": {
    "staging": {
      "workers_dev": true,
      "preview_urls": true,
      "ratelimits": [
        {
          "name": "CUSTOMER_RATE_LIMITER",
          "namespace_id": "1001",
          "simple": {
            "limit": 10,
            "period": 60
          }
        }
      ]
    }
  }
}
