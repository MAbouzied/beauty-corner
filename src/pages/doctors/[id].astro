---
import DoctorCard from '../../components/doctors/DoctorCard.astro';
import DoctorDetailContent from '../../components/doctors/DoctorDetailContent.astro';
import FaqSection from '../../components/sections/FaqSection.astro';
import BookingSection from '../../components/services/BookingSection.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import { doctors, getDoctorById } from '../../data/doctors';
import { faqItems } from '../../data/faq';
import { clinicServices } from '../../data/services';
import {
  buildBreadcrumbSchema,
  buildFaqSchema,
  buildPhysicianSchema,
  buildWebPageSchema,
} from '../../lib/schema';
import Layout from '../../layouts/Layout.astro';

export function getStaticPaths() {
  return doctors.map((doctor) => ({
    params: { id: doctor.id },
  }));
}

const { id } = Astro.params;
const doctor = getDoctorById(id ?? '');

if (!doctor) {
  return Astro.redirect('/doctors');
}

const site = Astro.site!;
const relatedService = clinicServices.find((service) => service.doctorSpecialty === doctor.specialty);
const relatedDoctors = doctors
  .filter((item) => item.specialty === doctor.specialty && item.id !== doctor.id)
  .slice(0, 3);
---

<Layout
  title={doctor.name}
  description={doctor.summary}
  image={doctor.image}
  ogType="profile"
  schemas={[
    buildWebPageSchema({
      site,
      path: `/doctors/${doctor.id}`,
      name: doctor.name,
      description: doctor.summary,
      type: 'ProfilePage',
    }),
    buildBreadcrumbSchema(site, [
      { name: 'الرئيسية', path: '/' },
      { name: 'الأطباء', path: '/doctors' },
      { name: doctor.name, path: `/doctors/${doctor.id}` },
    ]),
    buildPhysicianSchema(site, doctor),
    buildFaqSchema(faqItems),
  ]}
>
  <DoctorDetailContent doctor={doctor} />

  <BookingSection
    defaultSpecialty={doctor.specialty}
    defaultService={relatedService?.title}
  />

  {relatedDoctors.length > 0 && (
    <section class="py-14 sm:py-24" aria-labelledby="related-doctors-heading">
      <div class="page-container">
        <div id="related-doctors-heading">
          <SectionHeading eyebrow="أطباء آخرون" title="من نفس التخصص" />
        </div>
        <div class="mt-10 grid grid-cols-1 gap-6 md:grid-cols-3">
          {relatedDoctors.map((relatedDoctor) => <DoctorCard doctor={relatedDoctor} />)}
        </div>
      </div>
    </section>
  )}

  <FaqSection items={faqItems} />
</Layout>
