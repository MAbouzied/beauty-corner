---
export const prerender = false;

import Breadcrumbs from '../../components/seo/Breadcrumbs.astro';
import BookingSection from '../../components/services/BookingSection.astro';
import Layout from '../../layouts/Layout.astro';
import {
  buildBlogPostingSchema,
  buildBreadcrumbSchema,
  buildWebPageSchema,
} from '../../lib/schema';
import BlogArticle from '../../modules/blog/components/BlogArticle.astro';
import type { BlogPost } from '../../modules/blog/model/blog-types';
import {
  articleSeoDescription,
  articleSeoTitle,
  blogPath,
  normalizeBlogSlugParam,
  readingTimeForPost,
  selectRelatedPosts,
} from '../../modules/blog';
import { getBlogRepository } from '../../modules/blog/repository/get-blog-repository';
import {
  BLOG_CACHE_MAX_AGE_SECONDS,
  BLOG_CACHE_SWR_SECONDS,
  blogArticleCacheTags,
} from '../../modules/blog/cache';

const repository = getBlogRepository();
const slug = normalizeBlogSlugParam(Astro.params.slug);

if (!slug) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

let post: BlogPost | null;
try {
  post = await repository.getPostBySlug(slug);
} catch (error) {
  // A malformed requested document remains a hard failure; it must not be silently
  // replaced by another article or by a collection fallback.
  console.error(`[blog] Failed to map requested article "${slug}".`, error);
  return new Response(null, { status: 500, statusText: 'Unable to load article' });
}

if (!post) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

let allPosts: BlogPost[] = [];
try {
  allPosts = await repository.getPublishedPosts();
} catch (error) {
  // Related content must never make an otherwise valid article unavailable.
  console.error(`[blog] Failed to load related articles for "${post.id}".`, error);
}

if (Astro.cache.enabled) {
  Astro.cache.set({
    maxAge: BLOG_CACHE_MAX_AGE_SECONDS,
    swr: BLOG_CACHE_SWR_SECONDS,
    tags: blogArticleCacheTags(post.id),
  });
}

const relatedPosts = selectRelatedPosts(allPosts, post, 3);
const site = Astro.site!;
const path = blogPath(post.slug);
const title = articleSeoTitle(post);
const description = articleSeoDescription(post);
const readingTimeMinutes = readingTimeForPost(post);
const mainEntityId = `${new URL(path, site).href}#blogposting`;
---

<Layout
  title={title}
  description={description}
  image={post.cover.src}
  imageWidth={post.cover.width}
  imageHeight={post.cover.height}
  imageAlt={post.cover.alt}
  ogType="article"
  article={{
    publishedTime: post.publishedAt,
    modifiedTime: post.updatedAt ?? post.publishedAt,
    author: post.author.name,
    section: post.category.label,
    tags: [post.category.label],
  }}
  schemas={[
    buildWebPageSchema({
      site,
      path,
      name: title,
      description,
      mainEntityId,
    }),
    buildBreadcrumbSchema(site, [
      { name: 'الرئيسية', path: '/' },
      { name: 'المدونة', path: '/blogs' },
      { name: post.title, path },
    ]),
    buildBlogPostingSchema({
      site,
      post,
      path,
      readingTimeMinutes,
    }),
  ]}
>
  <Breadcrumbs
    items={[
      { name: 'الرئيسية', href: '/' },
      { name: 'المدونة', href: '/blogs' },
      { name: post.title },
    ]}
  />
  <div class="page-container">
    <BlogArticle post={post} relatedPosts={relatedPosts} />
  </div>
  <BookingSection />
</Layout>
