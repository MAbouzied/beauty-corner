---
import DoctorCard from '../../components/doctors/DoctorCard.astro';
import DevicesSection from '../../components/landing/DevicesSection.astro';
import ServiceCard from '../../components/services/ServiceCard.astro';
import FaqSection from '../../components/sections/FaqSection.astro';
import AssetIcon from '../../components/ui/AssetIcon.astro';
import ButtonLink from '../../components/ui/ButtonLink.astro';
import { buildPhoneUrl, buildWhatsAppUrl } from '../../data/contact';
import { doctors } from '../../data/doctors';
import { clinicServices } from '../../data/services';
import { localizeContact, localizeFaq, ui } from '../../lib/i18n/localize';
import {
  buildBreadcrumbSchema,
  buildFaqSchema,
  buildWebPageSchema,
} from '../../lib/schema';
import Layout from '../../layouts/Layout.astro';

const site = Astro.site!;
const copy = ui('en')!;
const contact = localizeContact('en');
const title = 'Dental & Dermatology Clinic in Hafr Al-Batin | Beauty Corner';
const description =
  'Beauty Corner dental and dermatology clinic in Hafr Al-Batin — Al Muhammadiyah, King Faisal Road. Book via the website or WhatsApp.';
const whatsappHref = buildWhatsAppUrl('Hello, I would like to book at Beauty Corner.');
const phoneHref = buildPhoneUrl();
const dentalServices = clinicServices.filter((service) => service.department === 'أسنان');
const landingDoctors = doctors.slice(0, 3);
const faqItems = localizeFaq('en');
---

<Layout
  title={title}
  description={description}
  locale="en"
  schemas={[
    buildWebPageSchema({
      site,
      path: '/en',
      name: title,
      description,
      locale: 'en',
    }),
    buildBreadcrumbSchema(site, [{ name: copy.nav.home, path: '/en' }]),
    buildFaqSchema(faqItems),
  ]}
>
  <section class="overflow-hidden border-b border-border bg-gradient-to-br from-surface-accent via-surface to-surface-soft py-12 sm:py-20">
    <div class="page-container grid items-center gap-8 lg:grid-cols-[1.05fr_0.95fr] lg:gap-14">
      <div>
        <p class="text-sm font-bold text-primary">{copy.home.eyebrow}</p>
        <h1 class="text-display-hero mt-4 font-black text-ink">{copy.home.heroTitle}</h1>
        <p class="mt-4 max-w-xl text-sm leading-7 text-muted sm:text-lg">{copy.home.heroText}</p>
        <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:flex-wrap" data-gtm-location="hero">
          <ButtonLink href="/en/book" size="lg">{copy.nav.quickBook}</ButtonLink>
          <ButtonLink href={whatsappHref} variant="outline" target="_blank" size="lg">
            {copy.common.whatsapp}
            <AssetIcon src="/assets/whatsapp.svg" size="sm" />
          </ButtonLink>
          <ButtonLink href={phoneHref} variant="outline" size="lg">
            {copy.common.call}
            <AssetIcon src="/assets/phone.svg" size="sm" />
          </ButtonLink>
        </div>
      </div>
      <img
        src="/assets/landing-hero.jpg"
        alt="Modern dental treatment room at Beauty Corner clinic in Hafr Al-Batin"
        width="167"
        height="256"
        sizes="(max-width: 1024px) 100vw, 45vw"
        class="aspect-[4/3] w-full rounded-[var(--radius-card)] object-cover shadow-[var(--shadow-card)]"
        fetchpriority="high"
        decoding="async"
      />
    </div>
  </section>

  <section class="border-b border-border bg-surface py-10 sm:py-14" aria-label="Clinic advantages">
    <ul class="page-container grid grid-cols-2 gap-3 lg:grid-cols-4">
      {copy.home.trust.map((point) => (
        <li class="flex min-h-12 items-center justify-center gap-2 rounded-full bg-surface-soft px-3 text-center text-[0.6875rem] font-bold sm:px-4 sm:text-sm">
          <span class="grid size-7 shrink-0 place-items-center rounded-full bg-success-soft sm:size-9">
            <AssetIcon src="/assets/plus.svg" size="sm" class="size-3 sm:size-4" />
          </span>
          {point}
        </li>
      ))}
    </ul>
  </section>

  <section id="services" class="bg-surface py-12 sm:py-20" aria-labelledby="en-services-heading">
    <div class="page-container">
      <h2 id="en-services-heading" class="text-display font-black text-ink">{copy.home.servicesTitle}</h2>
      <p class="mt-3 max-w-2xl text-sm leading-7 text-muted">{copy.home.servicesText}</p>
      <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {dentalServices.map((service) => <ServiceCard service={service} locale="en" />)}
      </div>
      <div class="mt-8">
        <ButtonLink href="/en/services" variant="outline">{copy.nav.services}</ButtonLink>
      </div>
    </div>
  </section>

  <DevicesSection locale="en" />

  <section class="bg-surface py-12 sm:py-20" aria-labelledby="en-doctors-heading">
    <div class="page-container">
      <h2 id="en-doctors-heading" class="text-display font-black text-ink">{copy.pages.doctorsHeading}</h2>
      <div class="mt-8 grid gap-6 md:grid-cols-3">
        {landingDoctors.map((doctor) => <DoctorCard doctor={doctor} locale="en" />)}
      </div>
    </div>
  </section>

  <section id="contact" class="bg-surface-soft py-12 sm:py-20" aria-labelledby="en-location-heading">
    <div class="page-container grid gap-8 lg:grid-cols-2 lg:items-center">
      <div>
        <h2 id="en-location-heading" class="text-display font-black text-ink">{copy.home.locationTitle}</h2>
        <ul class="mt-5 space-y-3 text-sm leading-7 text-muted">
          <li><strong class="text-ink">{copy.common.branch}:</strong> {contact.branch}</li>
          <li><strong class="text-ink">{copy.common.address}:</strong> {contact.location}</li>
          <li><strong class="text-ink">{copy.common.hours}:</strong> {contact.hours}</li>
          <li dir="ltr"><strong class="text-ink">Phone:</strong> {contact.phoneDisplay}</li>
        </ul>
        <div class="mt-6 flex flex-col gap-3 sm:flex-row">
          <ButtonLink href="/en/contact">{copy.common.bookAppointment}</ButtonLink>
          <ButtonLink href="/en/book" variant="outline">{copy.nav.quickBook}</ButtonLink>
        </div>
      </div>
      <img
        src="/assets/landing-clinic-gallery.jpg"
        alt="Beauty Corner clinic interior"
        class="aspect-[4/3] w-full rounded-[var(--radius-card)] object-cover shadow-[var(--shadow-card)]"
        loading="lazy"
      />
    </div>
  </section>

  <FaqSection items={faqItems} locale="en" />
</Layout>
