---
import ClinicLineButtons from '../../components/contact/ClinicLineButtons.astro';
import SocialLinks from '../../components/contact/SocialLinks.astro';
import BookingSection from '../../components/services/BookingSection.astro';
import FaqSection from '../../components/sections/FaqSection.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import AssetIcon from '../../components/ui/AssetIcon.astro';
import { localizeContact, localizeFaq, ui } from '../../lib/i18n/localize';
import {
  buildBreadcrumbSchema,
  buildFaqSchema,
  buildWebPageSchema,
} from '../../lib/schema';
import Layout from '../../layouts/Layout.astro';

const site = Astro.site!;
const copy = ui('en')!;
const contact = localizeContact('en');
const title = copy.pages.contactTitle;
const description = copy.pages.contactDescription;
const faqItems = localizeFaq('en');
const contactMessage = 'Hello, I would like to book at Beauty Corner.';
---

<Layout
  title={title}
  description={description}
  locale="en"
  schemas={[
    buildWebPageSchema({
      site,
      path: '/en/contact',
      name: title,
      description,
      type: 'ContactPage',
      locale: 'en',
    }),
    buildBreadcrumbSchema(site, [
      { name: copy.nav.home, path: '/en' },
      { name: copy.nav.contact, path: '/en/contact' },
    ]),
    buildFaqSchema(faqItems),
  ]}
>
  <section class="py-14 sm:py-24">
    <div class="page-container grid gap-8 lg:grid-cols-[0.9fr_1.1fr]">
      <div>
        <SectionHeading eyebrow={copy.nav.contact} title={copy.home.locationTitle} description={description} level={1} />
        <ul class="mt-8 space-y-4 text-sm leading-7 text-muted">
          <li class="flex items-start gap-3">
            <AssetIcon src="/assets/location.svg" size="sm" class="mt-1 shrink-0" />
            <span>{contact.location}</span>
          </li>
          <li class="flex items-start gap-3">
            <AssetIcon src="/assets/clock.svg" size="sm" class="mt-1 shrink-0" />
            <span>{contact.hours}</span>
          </li>
        </ul>
        <div class="mt-6" data-gtm-location="contact_page">
          <ClinicLineButtons
            locale="en"
            mode="both"
            showPhone
            whatsappMessage={contactMessage}
            callLabel={copy.common.call}
            whatsappLabel={copy.common.whatsapp}
          />
        </div>
        <SocialLinks locale="en" class="mt-6" id="contact-page-social" />
      </div>
      <img src="/assets/landing-clinic-gallery.jpg" alt="Beauty Corner clinic" class="aspect-[4/3] w-full rounded-[var(--radius-card)] object-cover shadow-[var(--shadow-card)]" />
    </div>
  </section>

  <BookingSection locale="en" />
  <FaqSection items={faqItems} locale="en" />
</Layout>
