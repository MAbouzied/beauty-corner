---
import LandingHero from '../components/landing/LandingHero.astro';
import LandingSections from '../components/landing/LandingSections.astro';
import { faqItems } from '../data/faq';
import {
  buildBreadcrumbSchema,
  buildFaqSchema,
  buildWebPageSchema,
} from '../lib/schema';
import Layout from '../layouts/Layout.astro';

const site = Astro.site!;
const title = 'عيادة أسنان وجلدية في حفر الباطن | بيوتي كورنر';
const description =
  'عيادة بيوتي كورنر لطب الأسنان والجلدية في حفر الباطن — حي المحمدية، طريق الملك فيصل. احجز موعدك بسهولة عبر الموقع أو واتساب.';
---

<Layout
  title={title}
  description={description}
  schemas={[
    buildWebPageSchema({
      site,
      path: '/',
      name: title,
      description,
      locale: 'ar',
    }),
    buildBreadcrumbSchema(site, [{ name: 'الرئيسية', path: '/' }]),
    buildFaqSchema(faqItems),
  ]}
>
  <LandingHero />
  <LandingSections />
</Layout>
