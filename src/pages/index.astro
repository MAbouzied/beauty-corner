---
import LandingHero from '../components/landing/LandingHero.astro';
import LandingSections from '../components/landing/LandingSections.astro';
import { organization } from '../data/organization';
import {
  buildBreadcrumbSchema,
  buildWebPageSchema,
} from '../lib/schema';
import Layout from '../layouts/Layout.astro';

const site = Astro.site!;
const title = 'الرئيسية';
const description = organization.description;
---

<Layout
  title={title}
  description={description}
  image="/assets/landing-hero.jpg"
  schemas={[
    buildWebPageSchema({
      site,
      path: '/',
      name: `${organization.name} | عيادة أسنان وجلدية وليزر`,
      description,
    }),
    buildBreadcrumbSchema(site, [{ name: 'الرئيسية', path: '/' }]),
  ]}
>
  <LandingHero />
  <LandingSections />
</Layout>
