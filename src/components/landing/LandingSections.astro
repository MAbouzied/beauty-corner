---
import { buildPhoneUrl, buildWhatsAppUrl, clinicContact } from '../../data/contact';
import { doctors } from '../../data/doctors';
import { faqItems } from '../../data/faq';
import { clinicServices } from '../../data/services';
import {
  clinicBenefits,
  experiencePoints,
  openingHours,
  serviceGroups,
  trustPoints,
} from '../../data/landing';
import { clinicMapUrl } from '../../data/seo';
import DoctorCard from '../doctors/DoctorCard.astro';
import FaqSection from '../sections/FaqSection.astro';
import ServiceCard from '../services/ServiceCard.astro';
import AssetIcon from '../ui/AssetIcon.astro';
import ButtonLink from '../ui/ButtonLink.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import DevicesSection from './DevicesSection.astro';

const landingDoctors = doctors.slice(0, 3);
const landingServices = clinicServices.filter((service) => service.department === 'أسنان');
const whatsappHref = buildWhatsAppUrl('مرحباً، أود الحجز عبر بيوتي كورنر.');
const phoneHref = buildPhoneUrl();
---

<section class="border-b border-border bg-surface py-12 sm:py-16" aria-label="مزايا العيادة">
  <ul class="page-container grid grid-cols-2 gap-3 sm:grid-cols-2 lg:grid-cols-4">
    {trustPoints.map((point) => (
      <li class="flex min-h-12 items-center justify-center gap-2 rounded-full bg-surface-soft px-3 text-center text-[0.6875rem] font-bold sm:gap-3 sm:px-4 sm:text-sm">
        <span class="grid size-7 shrink-0 place-items-center rounded-full bg-success-soft sm:size-9">
          <AssetIcon src="/assets/plus.svg" size="sm" class="size-3 sm:size-4" />
        </span>
        {point}
      </li>
    ))}
  </ul>
</section>

<section id="specialties" class="bg-surface-soft py-12 sm:py-24" aria-labelledby="specialties-heading">
  <div class="page-container">
    <div id="specialties-heading"><SectionHeading eyebrow="خدماتنا" title="خدمات طب الأسنان في مكان واحد" /></div>
    <div class="mt-8 grid gap-4 sm:mt-10 sm:gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {landingServices.map((service) => <ServiceCard service={service} />)}
    </div>
  </div>
</section>

<section id="services" class="bg-surface py-12 sm:py-24" aria-labelledby="selected-services-heading">
  <div class="page-container">
    <div id="selected-services-heading">
      <SectionHeading
        eyebrow="الخدمات"
        title="خدمات مختارة بعناية طبية"
        description="مجموعة من أهم الخدمات لدينا. للاطلاع على القائمة الكاملة يمكنك التواصل معنا."
      />
    </div>
    <div class="mt-8 grid gap-4 sm:mt-10 sm:gap-5 md:grid-cols-3">
      {serviceGroups.map((group) => (
        <article class="rounded-[var(--radius-card)] border border-border bg-surface p-5 shadow-[var(--shadow-card)] sm:p-7">
          <div class="flex items-center justify-between gap-4">
            <h3 class="text-lg font-bold sm:text-xl">{group.title}</h3>
            <span class="rounded-full bg-surface-accent px-2.5 py-0.5 text-[0.6875rem] font-bold text-primary sm:px-3 sm:py-1 sm:text-xs">{group.items.length} خدمات</span>
          </div>
          <ul class="mt-4 space-y-2 text-sm text-muted sm:mt-5 sm:space-y-3">
            {group.items.map((item) => (
              <li class="flex items-start gap-2">
                <AssetIcon src="/assets/plus.svg" size="sm" class="mt-0.5 shrink-0" />
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </div>
</section>

<section id="why-beauty-corner" class="bg-surface-soft py-12 sm:py-24" aria-labelledby="why-heading">
  <div class="page-container grid gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:items-start">
    <div>
      <span class="inline-block" id="why-heading">
        <SectionHeading eyebrow="لماذا بيوتي كورنر" title="تجربة طبية تشعرك بالاطمئنان" />
      </span>
      <p class="mt-5 max-w-xl text-base leading-7 text-muted">
        نجمع بين الخبرة الطبية والتقنيات الحديثة داخل بيئة هادئة وخاصة، لنقدّم لك رعاية مصممة خصيصًا لحالتك.
      </p>
    </div>
    <div class="grid gap-3 sm:mt-10 sm:grid-cols-2 sm:gap-4">
      {clinicBenefits.map(([title, description]) => (
        <article class="rounded-[var(--radius-section)] border border-border bg-surface p-4 sm:p-5">
          <span class="grid size-9 place-items-center rounded-2xl bg-surface-accent sm:size-11"><AssetIcon src="/assets/plus.svg" size="sm" /></span>
          <h3 class="mt-3 font-bold sm:mt-4">{title}</h3>
          <p class="mt-1 text-sm leading-6 text-muted">{description}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<DevicesSection />

<section class="bg-surface py-12 sm:py-24" aria-labelledby="doctors-heading">
  <div class="page-container">
    <div id="doctors-heading"><SectionHeading eyebrow="فريقنا الطبي" title="أطباء متخصصون بخبرة موثوقة" /></div>
    <div class="mt-10 grid gap-6 md:grid-cols-3">
      {landingDoctors.map((doctor) => <DoctorCard doctor={doctor} />)}
    </div>
  </div>
</section>

<section class="bg-surface-soft py-12 sm:py-24" aria-labelledby="gallery-heading">
  <div class="page-container">
    <div id="gallery-heading"><SectionHeading eyebrow="نماذج من العيادة" title="لمحة من داخل العيادة" /></div>
    <img
      src="/assets/landing-clinic-gallery.jpg"
      alt="منطقة الاستقبال والانتظار المضيئة داخل عيادة بيوتي كورنر"
      class="mt-6 aspect-[4/3] w-full rounded-[var(--radius-card)] object-cover shadow-[var(--shadow-card)] sm:mt-8 sm:aspect-[16/9]"
      loading="lazy"
    />
  </div>
</section>

<section id="payment-options" class="bg-surface py-12 sm:py-24" aria-labelledby="payment-heading">
  <div class="page-container">
    <div id="payment-heading">
      <SectionHeading
        eyebrow="خيارات الدفع"
        title="ادفع بالطريقة الأنسب لك"
        description="تتوفر داخل العيادة خيارات دفع متعددة. اسأل الاستقبال عن الوسائل المتاحة عند تأكيد موعدك."
      />
    </div>
    <div class="mt-8 overflow-hidden rounded-[var(--radius-card)] border border-border bg-gradient-to-bl from-surface-accent via-surface to-success-soft p-5 shadow-[var(--shadow-card)] sm:mt-10 sm:p-10">
      <h3 class="text-xl font-black text-balance sm:text-3xl">مرونة في الدفع داخل العيادة</h3>
      <p class="mt-3 max-w-3xl text-sm leading-7 text-muted">
        يوضح فريق الاستقبال وسائل الدفع المتاحة لكل خدمة عند تأكيد الموعد، بما في ذلك أي خيارات تقسيط إن توفرت وفق شروط مزوّد الخدمة.
      </p>
      <ButtonLink href="/book" size="lg" class="mt-6">احجز موعدك الآن</ButtonLink>
    </div>
  </div>
</section>

<section class="bg-surface-soft py-12 sm:py-24" aria-labelledby="hours-heading">
  <div class="page-container">
    <div id="hours-heading">
      <SectionHeading
        eyebrow="مواعيد العمل"
        title="مواعيد العمل والحجز"
        description="جدول عمل العيادة الأسبوعي — يخضع للتحديث خلال شهر رمضان والإجازات الرسمية."
      />
    </div>
    <div class="mt-8 grid gap-6 sm:mt-10 lg:grid-cols-[1.2fr_0.8fr]">
      <div class="overflow-hidden rounded-[var(--radius-card)] border border-border bg-surface shadow-[var(--shadow-card)]">
        <div class="flex flex-wrap items-center justify-between gap-3 border-b border-border p-4 sm:p-5">
          <h3 class="font-bold">جدول العمل الأسبوعي</h3>
          <span class="rounded-full bg-surface-soft px-3 py-1 text-xs">حفر الباطن</span>
        </div>
        <dl>
          {openingHours.map(([day, hours]) => (
              <div class="flex items-center justify-between gap-3 border-b border-border px-4 py-3 text-sm sm:gap-4 sm:px-5 sm:py-4">
              <dt class="font-bold">{day}</dt>
              <dd class="text-sm text-muted">{hours}</dd>
            </div>
          ))}
        </dl>
      </div>
      <aside class="flex flex-col justify-center rounded-[var(--radius-card)] border border-border bg-surface p-5 shadow-[var(--shadow-card)] sm:p-7">
        <h3 class="text-xl font-black text-balance sm:text-2xl">احجز موعدك بسهولة</h3>
        <p class="mt-3 text-sm leading-7 text-pretty text-muted">قد تختلف مواعيد بعض الأطباء والخدمات حسب جدول الحجوزات. يرجى تأكيد الموعد قبل زيارة العيادة.</p>
        <ul class="mt-5 space-y-3 text-sm"><li>✓ حجز إلكتروني خلال دقيقة</li><li>✓ تأكيد فوري عبر واتساب</li><li>✓ إعادة جدولة مرنة</li></ul>
        <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:flex-wrap" data-gtm-location="hours_cta">
          <ButtonLink href="/book" class="w-full justify-center sm:w-auto">احجز موعدك</ButtonLink>
          <ButtonLink href={whatsappHref} variant="outline" target="_blank" class="w-full justify-center sm:w-auto">
            واتساب
            <AssetIcon src="/assets/whatsapp.svg" size="sm" />
          </ButtonLink>
          <ButtonLink href={phoneHref} variant="outline" class="w-full justify-center sm:w-auto">
            اتصال
            <AssetIcon src="/assets/phone.svg" size="sm" />
          </ButtonLink>
        </div>
      </aside>
    </div>
  </div>
</section>

<section class="bg-surface py-12 sm:py-24" aria-labelledby="experience-heading">
  <div class="page-container grid items-center gap-10 lg:grid-cols-2 lg:gap-16">
    <img
      src="/assets/landing-waiting-area.jpg"
      alt="غرفة انتظار مريحة ومضيئة داخل عيادة بيوتي كورنر"
      width="187"
      height="256"
      sizes="(max-width: 1024px) 100vw, 50vw"
      class="aspect-[7/5] w-full rounded-[var(--radius-card)] object-cover shadow-[var(--shadow-card)]"
      loading="lazy"
      decoding="async"
    />
    <div>
      <div id="experience-heading"><SectionHeading eyebrow="التجربة داخل العيادة" title="بيئة طبية بلمسة هادئة وخاصة" /></div>
      <div class="mt-6 grid gap-3 sm:mt-8 sm:grid-cols-2 sm:gap-4">
        {experiencePoints.map(([title, description]) => (
          <article class="rounded-[var(--radius-section)] border border-border bg-surface-soft p-4 sm:p-5">
            <span class="grid size-10 place-items-center rounded-2xl bg-success-soft"><AssetIcon src="/assets/plus.svg" size="sm" /></span>
            <h3 class="mt-4 font-bold">{title}</h3>
            <p class="mt-1 text-sm leading-6 text-muted">{description}</p>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<section id="contact" class="bg-surface-soft py-12 sm:py-24" aria-labelledby="contact-heading">
  <div class="page-container">
    <div id="contact-heading"><SectionHeading eyebrow="الموقع والتواصل" title="نحن قريبون منك" /></div>
    <div class="mt-8 grid gap-5 sm:mt-10 sm:gap-6 lg:grid-cols-[0.9fr_1.1fr]">
      <address class="not-italic rounded-[var(--radius-card)] border border-border bg-surface p-5 shadow-[var(--shadow-card)] sm:p-7">
        <dl class="space-y-5">
          <div><dt class="text-xs font-bold">العنوان</dt><dd class="mt-1 text-sm text-muted">{clinicContact.location}</dd></div>
          <div><dt class="text-xs font-bold">أوقات العمل</dt><dd class="mt-1 text-sm text-muted">{clinicContact.hours}</dd></div>
          <div>
            <dt class="text-xs font-bold">الهاتف وواتساب</dt>
            <dd class="mt-1 flex flex-wrap gap-3 text-sm text-muted" data-gtm-location="contact">
              <a href={phoneHref} dir="ltr" class="hover:text-primary">{clinicContact.phoneDisplay}</a>
              <a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="font-bold text-success hover:underline">واتساب</a>
              <a href={phoneHref} class="font-bold text-primary hover:underline">اتصال</a>
            </dd>
          </div>
          <div data-gtm-location="contact"><dt class="text-xs font-bold">البريد</dt><dd class="mt-1 text-sm text-muted"><a href={`mailto:${clinicContact.email}`}>{clinicContact.email}</a></dd></div>
          <div><dt class="text-xs font-bold">مواقف السيارات</dt><dd class="mt-1 text-sm text-muted">متوفرة أمام الفرع</dd></div>
        </dl>
      </address>
      <div class="overflow-hidden rounded-[var(--radius-card)] border border-border bg-surface shadow-[var(--shadow-card)]">
        <iframe
          title="موقع عيادة بيوتي كورنر على خرائط جوجل"
          src="https://www.google.com/maps?q=%D8%AD%D9%8A+%D8%A7%D9%84%D9%85%D8%AD%D9%85%D8%AF%D9%8A%D8%A9+%D8%B7%D8%B1%D9%8A%D9%82+%D8%A7%D9%84%D9%85%D9%84%D9%83+%D9%81%D9%8A%D8%B5%D9%84+%D8%AD%D9%81%D8%B1+%D8%A7%D9%84%D8%A8%D8%A7%D8%B7%D9%86&output=embed"
          class="min-h-80 w-full border-0"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
        ></iframe>
        <div class="border-t border-border px-4 py-3 text-center">
          <a href={clinicMapUrl} target="_blank" rel="noopener noreferrer" class="text-sm font-bold text-primary hover:underline">
            فتح الموقع في خرائط جوجل
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<FaqSection items={faqItems} />
