---
import AssetIcon from '../ui/AssetIcon.astro';
import ButtonLink from '../ui/ButtonLink.astro';
---

<section class="overflow-hidden border-b border-border bg-gradient-to-bl from-surface-accent via-surface to-surface-soft py-10 sm:py-16 lg:py-24">
  <div class="page-container grid items-center gap-8 lg:grid-cols-[1fr_0.9fr] lg:gap-16">
    <div class="order-2 lg:order-1">
      <div class="inline-flex max-w-full flex-wrap items-center gap-x-2 gap-y-1 rounded-full border border-primary/20 bg-surface-accent px-3 py-1.5 text-[0.6875rem] leading-5 text-primary sm:px-3.5 sm:py-2 sm:text-xs">
        <span class="size-1.5 shrink-0 rounded-full bg-primary" aria-hidden="true"></span>
        <span class="min-w-0">عيادة <strong>بيوتي كورنر</strong> متعددة التخصصات</span>
        <a href="#services" class="shrink-0 font-bold underline-offset-4 hover:underline">عروض الصيف</a>
      </div>
      <h1 class="text-display-hero mt-5 max-w-2xl font-black">
        رعاية متكاملة <span class="text-gold">لابتسامتك</span> وبشرتك
      </h1>
      <p class="mt-3 max-w-2xl text-sm leading-7 text-pretty text-muted sm:text-lg lg:text-xl">
        خدمات الأسنان والجلدية بخطط علاجية تناسب احتياجك، في فرعنا بحفر الباطن — حي المحمدية، طريق الملك فيصل.
      </p>
      <ButtonLink href="/book" size="lg" class="mt-6 w-full whitespace-nowrap sm:w-auto">
        احجز موعدك الآن
        <AssetIcon src="/assets/booking-arrow.svg" size="sm" />
      </ButtonLink>
    </div>

    <div class="relative order-1 mx-auto w-full max-w-xl lg:order-2">
      <img
        src="/assets/landing-hero.jpg"
        alt="غرفة علاج أسنان حديثة داخل عيادة بيوتي كورنر بحفر الباطن"
        width="167"
        height="256"
        sizes="(max-width: 1024px) 100vw, 40vw"
        class="aspect-[4/3] w-full rounded-[var(--radius-card)] object-cover shadow-[var(--shadow-card)]"
        fetchpriority="high"
        decoding="async"
      />
      <div class="mx-auto -mt-6 flex w-[calc(100%-1.5rem)] max-w-sm items-center gap-3 rounded-[var(--radius-section)] border border-border bg-surface/95 p-3 shadow-[var(--shadow-card)] backdrop-blur-sm sm:absolute sm:-bottom-7 sm:start-5 sm:mt-0 sm:w-[calc(100%-2.5rem)] sm:p-4">
        <span class="grid size-9 shrink-0 place-items-center rounded-full bg-surface-accent text-primary sm:size-10" aria-hidden="true">♡</span>
        <div>
          <p class="text-xs font-bold sm:text-sm">تقييم طبي قبل كل خطة علاجية</p>
          <p class="text-[0.6875rem] text-muted sm:text-xs">لضمان اختيار الحل الأنسب لحالتك</p>
        </div>
      </div>
    </div>
  </div>
</section>
