---
import { buildPhoneUrl, buildWhatsAppUrl } from '../../data/contact';
import { clinicServices } from '../../data/services';
import type { Locale } from '../../lib/i18n/localize';
import {
  isEnglish,
  localizeContact,
  localizeDepartment,
  localizeService,
  ui,
} from '../../lib/i18n/localize';
import AssetIcon from '../ui/AssetIcon.astro';
import PillLabel from '../ui/PillLabel.astro';

export interface Props {
  defaultDepartment?: string;
  defaultService?: string;
  locale?: Locale;
}

const { defaultDepartment = '', defaultService = '', locale = 'ar' } = Astro.props;
const en = isEnglish(locale);
const copy = ui(locale);
const contact = localizeContact(locale);

const departments = ['أسنان', 'جلدية'] as const;
const servicesPayload = clinicServices.map((service) => {
  const localized = localizeService(service, locale);
  return {
    value: service.title,
    label: localized.title,
    department: service.department,
  };
});
const phoneHref = buildPhoneUrl();
const whatsappHref = buildWhatsAppUrl(
  en ? 'Hello, I would like to book at Beauty Corner.' : 'مرحباً، أود الحجز عبر بيوتي كورنر.',
);
const fieldClass =
  'min-h-12 w-full rounded-[1.25rem] border border-border bg-surface px-4 text-sm text-ink shadow-[var(--shadow-control)] placeholder:text-muted/70 focus:border-primary aria-[invalid=true]:border-danger';

const labels = en
  ? {
      eyebrow: copy!.booking.eyebrow,
      title: copy!.booking.title,
      subtitle: copy!.booking.subtitle,
      whatsapp: copy!.common.whatsapp,
      call: copy!.common.call,
      name: copy!.common.fullName,
      phone: copy!.common.phone,
      department: copy!.common.department,
      service: copy!.common.service,
      chooseDepartment: copy!.common.chooseDepartment,
      chooseService: copy!.common.chooseService,
      consent: copy!.common.consent,
      send: copy!.common.sendWhatsapp,
      namePh: copy!.common.namePlaceholder,
      phonePh: copy!.common.phonePlaceholder,
      errors: copy!.booking.errors,
      statusInvalid: copy!.booking.statusInvalid,
      statusOpening: copy!.booking.statusOpening,
    }
  : {
      eyebrow: 'احجز موعدك',
      title: 'احجز سريعا الآن',
      subtitle: 'املأ الاسم ورقم الجوال واختر القسم والخدمة، ثم أرسل الطلب عبر واتساب.',
      whatsapp: 'واتساب',
      call: 'اتصال',
      name: 'الاسم الكامل',
      phone: 'رقم الجوال',
      department: 'القسم',
      service: 'الخدمة',
      chooseDepartment: 'اختر القسم',
      chooseService: 'اختر الخدمة',
      consent: 'أوافق على سياسة الخصوصية والتواصل معي لتأكيد الحجز.',
      send: 'إرسال عبر واتساب',
      namePh: 'مثال: عبدالله محمد',
      phonePh: '05XXXXXXXX',
      errors: {
        name: 'يرجى إدخال الاسم الكامل (3 أحرف على الأقل).',
        phone: 'يرجى إدخال رقم جوال سعودي بصيغة 05XXXXXXXX.',
        department: 'يرجى اختيار القسم.',
        service: 'يرجى اختيار الخدمة.',
        consent: 'الموافقة مطلوبة للمتابعة.',
      },
      statusInvalid: 'يرجى تصحيح الحقول الموضحة قبل المتابعة.',
      statusOpening: 'جارٍ فتح واتساب لإرسال طلب الحجز...',
    };
---

<section id="booking" class="bg-surface-soft/60 py-20 sm:py-24" aria-labelledby="booking-heading">
  <div class="page-container">
    <div class="grid items-start gap-6 rounded-[2rem] border border-border bg-surface-soft p-4 shadow-[var(--shadow-card)] sm:gap-10 sm:p-8 lg:grid-cols-[0.84fr_1.16fr] lg:gap-14 lg:p-10">
      <div>
        <PillLabel text={labels.eyebrow} />
        <h2 id="booking-heading" class="text-display mt-4 font-black text-ink">{labels.title}</h2>
        <p class="mt-4 max-w-lg text-sm leading-7 text-pretty text-muted">{labels.subtitle}</p>

        <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:flex-wrap" data-gtm-location="booking_section_sidebar">
          <a
            href={whatsappHref}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex min-h-12 w-full items-center justify-center gap-2 rounded-full border border-success/40 bg-success-soft px-5 text-sm font-bold whitespace-nowrap text-success transition-transform hover:-translate-y-0.5 sm:w-auto"
          >
            {labels.whatsapp}
            <AssetIcon src="/assets/whatsapp.svg" size="sm" />
          </a>
          <a
            href={phoneHref}
            class="inline-flex min-h-12 w-full items-center justify-center gap-2 rounded-full border border-primary/30 bg-surface-accent px-5 text-sm font-bold whitespace-nowrap text-primary transition-transform hover:-translate-y-0.5 sm:w-auto"
          >
            {labels.call}
            <AssetIcon src="/assets/phone.svg" size="sm" />
          </a>
        </div>

        <address class="mt-5 space-y-2 text-sm not-italic text-muted sm:mt-7 sm:space-y-3" aria-label={en ? 'Contact details' : 'بيانات التواصل'} data-gtm-location="booking_section_sidebar">
          <p class="flex items-center gap-2 sm:gap-3" dir="ltr">
            <AssetIcon src="/assets/phone.svg" size="sm" class="shrink-0" />
            <a href={phoneHref} class="hover:text-primary">{contact.phoneDisplay}</a>
          </p>
          <p class="flex items-center gap-2 sm:gap-3">
            <AssetIcon src="/assets/clock.svg" size="sm" class="shrink-0" />
            <span class="leading-5">{contact.hours}</span>
          </p>
          <p class="flex items-center gap-2 sm:gap-3">
            <AssetIcon src="/assets/location.svg" size="sm" class="shrink-0" />
            <span class="leading-5">{contact.location}</span>
          </p>
        </address>
      </div>

      <form
        id="booking-form"
        class="rounded-[2rem] border border-border bg-surface p-4 shadow-[var(--shadow-card)] sm:p-8"
        novalidate
        data-gtm-form="booking_section"
        data-services={JSON.stringify(servicesPayload)}
        data-locale={locale}
        data-msg-invalid={labels.statusInvalid}
        data-msg-opening={labels.statusOpening}
        data-msg-name={labels.errors.name}
        data-msg-phone={labels.errors.phone}
        data-msg-department={labels.errors.department}
        data-msg-service={labels.errors.service}
        data-msg-consent={labels.errors.consent}
        data-choose-service={labels.chooseService}
      >
        <label class="sr-only" aria-hidden="true">
          Website
          <input name="website" type="text" tabindex="-1" autocomplete="off" />
        </label>
        <div class="grid gap-4">
          <div class="space-y-1.5">
            <label for="booking-name" class="block text-xs font-bold">{labels.name}</label>
            <input id="booking-name" name="name" type="text" class={fieldClass} placeholder={labels.namePh} autocomplete="name" minlength="3" required />
            <p class="hidden text-xs text-danger" data-error-for="booking-name"></p>
          </div>
          <div class="space-y-1.5">
            <label for="booking-phone" class="block text-xs font-bold">{labels.phone}</label>
            <input id="booking-phone" name="phone" type="tel" dir="ltr" class={fieldClass} placeholder={labels.phonePh} autocomplete="tel" inputmode="numeric" pattern="05[0-9]{8}" required />
            <p class="hidden text-xs text-danger" data-error-for="booking-phone"></p>
          </div>
          <div class="space-y-1.5">
            <label for="booking-department" class="block text-xs font-bold">{labels.department}</label>
            <select id="booking-department" name="department" class={fieldClass} required>
              <option value="">{labels.chooseDepartment}</option>
              {departments.map((department) => (
                <option value={department} selected={department === defaultDepartment}>
                  {localizeDepartment(department, locale)}
                </option>
              ))}
            </select>
            <p class="hidden text-xs text-danger" data-error-for="booking-department"></p>
          </div>
          <div class="space-y-1.5">
            <label for="booking-service" class="block text-xs font-bold">{labels.service}</label>
            <select id="booking-service" name="service" class={fieldClass} required data-default-service={defaultService}>
              <option value="">{labels.chooseService}</option>
            </select>
            <p class="hidden text-xs text-danger" data-error-for="booking-service"></p>
          </div>
        </div>

        <label class="mt-5 flex cursor-pointer items-start gap-3 text-xs leading-5 text-muted">
          <input id="booking-consent" name="consent" type="checkbox" class="mt-0.5 size-4 accent-primary" required />
          <span>
            {en ? (
              <>
                I agree to the
                {' '}
                <a href="/en/privacy" class="font-bold text-primary underline-offset-2 hover:underline">privacy policy</a>
                {' '}
                and to be contacted to confirm the booking.
              </>
            ) : (
              <>
                أوافق على
                {' '}
                <a href="/privacy" class="font-bold text-primary underline-offset-2 hover:underline">سياسة الخصوصية</a>
                {' '}
                والتواصل معي لتأكيد الحجز.
              </>
            )}
          </span>
        </label>
        <p class="mt-1 hidden text-xs text-danger" data-error-for="booking-consent"></p>

        <button type="submit" class="mt-6 inline-flex min-h-[3.25rem] w-full items-center justify-center gap-2 rounded-full bg-gold-gradient px-7 text-sm font-bold whitespace-nowrap text-ink-button shadow-[var(--shadow-gold)] transition-transform hover:-translate-y-0.5 sm:text-base">
          {labels.send}
          <AssetIcon src="/assets/whatsapp.svg" size="sm" />
        </button>
        <p id="booking-status" class="mt-4 min-h-5 text-center text-sm font-medium" role="status" aria-live="polite"></p>
      </form>
    </div>
  </div>
</section>

<script>
  import { buildBookingWhatsAppMessage, buildWhatsAppUrl, clinicContact } from '../../data/contact';
  import { saveCustomerLead } from '../../lib/customer-leads';
  import { GtmEvents, pushGtmEvent } from '../../lib/gtm';

  document.addEventListener('astro:page-load', () => {
    const bookingForm = document.querySelector<HTMLFormElement>('#booking-form');
    if (!bookingForm || bookingForm.dataset.bound === 'true') return;
    bookingForm.dataset.bound = 'true';

    const bookingStatus = document.querySelector<HTMLElement>('#booking-status');
    const departmentSelect = bookingForm.querySelector<HTMLSelectElement>('#booking-department');
    const serviceSelect = bookingForm.querySelector<HTMLSelectElement>('#booking-service');
    const formId = bookingForm.dataset.gtmForm ?? 'booking_section';
    const requiredFields = [
      ...bookingForm.querySelectorAll<HTMLInputElement | HTMLSelectElement>('input[required], select[required]'),
    ];

    type ServiceOption = { value: string; label: string; department: string };
    let services: ServiceOption[] = [];
    try {
      services = JSON.parse(bookingForm.dataset.services ?? '[]') as ServiceOption[];
    } catch {
      services = [];
    }

    const chooseService = bookingForm.dataset.chooseService ?? 'اختر الخدمة';

    const populateServices = () => {
      if (!departmentSelect || !serviceSelect) return;
      const department = departmentSelect.value;
      const defaultService = serviceSelect.dataset.defaultService ?? '';
      const options = services.filter((service) => service.department === department);

      serviceSelect.innerHTML = `<option value="">${chooseService}</option>`;
      options.forEach((service) => {
        const option = document.createElement('option');
        option.value = service.value;
        option.textContent = service.label;
        if (service.value === defaultService || service.label === defaultService) option.selected = true;
        serviceSelect.append(option);
      });
    };

    populateServices();
    departmentSelect?.addEventListener('change', populateServices);

    const messages: Readonly<Record<string, string>> = {
      'booking-name': bookingForm.dataset.msgName ?? '',
      'booking-phone': bookingForm.dataset.msgPhone ?? '',
      'booking-department': bookingForm.dataset.msgDepartment ?? '',
      'booking-service': bookingForm.dataset.msgService ?? '',
      'booking-consent': bookingForm.dataset.msgConsent ?? '',
    };

    const showFieldState = (field: HTMLInputElement | HTMLSelectElement) => {
      const error = document.querySelector<HTMLElement>(`[data-error-for="${field.id}"]`);
      const isValid = field.checkValidity();
      field.setAttribute('aria-invalid', String(!isValid));
      if (error) {
        error.textContent = isValid ? '' : messages[field.id] ?? '';
        error.classList.toggle('hidden', isValid);
      }
      return isValid;
    };

    requiredFields.forEach((field) => {
      field.addEventListener('blur', () => showFieldState(field));
      field.addEventListener('input', () => {
        if (field.getAttribute('aria-invalid') === 'true') showFieldState(field);
      });
      field.addEventListener('change', () => {
        if (field.getAttribute('aria-invalid') === 'true') showFieldState(field);
      });
    });

    bookingForm.addEventListener('submit', (event) => {
      event.preventDefault();
      const isValid = requiredFields.every(showFieldState);

      if (!isValid) {
        pushGtmEvent(GtmEvents.formError, { form_id: formId, method: 'whatsapp' });
        if (bookingStatus) {
          bookingStatus.textContent = bookingForm.dataset.msgInvalid ?? '';
          bookingStatus.className = 'mt-4 min-h-5 text-center text-sm font-medium text-danger';
        }
        requiredFields.find((field) => !field.checkValidity())?.focus();
        return;
      }

      const data = new FormData(bookingForm);
      const department = String(data.get('department') ?? '').trim();
      const service = String(data.get('service') ?? '').trim();
      const message = buildBookingWhatsAppMessage({
        name: String(data.get('name') ?? '').trim(),
        phone: String(data.get('phone') ?? '').trim(),
        department,
        service,
        branch: clinicContact.branch,
      });

      if (bookingStatus) {
        bookingStatus.textContent = bookingForm.dataset.msgOpening ?? '';
        bookingStatus.className = 'mt-4 min-h-5 text-center text-sm font-medium text-success';
      }

      pushGtmEvent(GtmEvents.formSubmit, {
        form_id: formId,
        method: 'whatsapp',
        department,
        service,
      });

      void saveCustomerLead({
        name: String(data.get('name') ?? '').trim(),
        phone: String(data.get('phone') ?? '').trim(),
        department,
        service,
        locale: bookingForm.dataset.locale === 'en' ? 'en' : 'ar',
        consent: data.has('consent'),
        website: String(data.get('website') ?? ''),
      }).catch((error) => console.error('Unable to save booking details.', error));

      window.open(buildWhatsAppUrl(message), '_blank', 'noopener,noreferrer');
    });
  });
</script>
