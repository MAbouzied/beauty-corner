---
import AssetIcon from '../ui/AssetIcon.astro';
import SocialLinks from './SocialLinks.astro';
import { clinicLines } from '../../data/contact';
import { getFormLandingCopy } from '../../data/form-landing';
import { clinicMapUrl } from '../../data/seo';
import { localizeContact, languageSwitchHref, type Locale } from '../../lib/i18n/localize';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = getFormLandingCopy(locale);
const contact = localizeContact(locale);
const languageHref = languageSwitchHref(
  Astro.url.pathname,
  locale,
  Astro.url.search,
  Astro.url.hash,
);
const fieldClass =
  'min-h-12 w-full min-w-0 max-w-full rounded-2xl border border-border bg-surface px-4 text-sm text-ink shadow-[var(--shadow-control)] placeholder:text-placeholder focus:border-primary';
---

<section class="min-h-dvh overflow-x-clip bg-surface" dir={locale === 'en' ? 'ltr' : 'rtl'}>
  <div class="page-container flex min-h-dvh w-full min-w-0 max-w-5xl flex-col py-6 sm:py-10">
    <div class="flex flex-wrap items-center justify-between gap-3 sm:gap-4">
      <a href={copy.homeHref} class="inline-flex items-center" aria-label={copy.brandHomeAria}>
        <img src="/assets/logo.svg" alt="" width="50" height="42" class="h-12 w-auto sm:h-14" />
      </a>
      <a
        href={languageHref}
        data-language-switcher
        class="inline-flex min-h-9 items-center justify-center gap-1.5 rounded-full border border-border px-3 text-xs font-bold text-ink hover:bg-surface-accent sm:min-h-11 sm:px-4 sm:text-sm"
        aria-label={copy.languageAria}
        hreflang={locale === 'en' ? 'ar' : 'en'}
      >
        <AssetIcon src="/assets/globe.svg" size="sm" />
        <span>{copy.languageLabel}</span>
      </a>
    </div>

    <nav class="mt-6" aria-label={copy.breadcrumbsAria} data-form-landing-crumb>
      <ol class="flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-muted">
        <li class="inline-flex min-w-0 items-center gap-2">
          <a href={copy.homeHref} class="truncate transition-colors hover:text-primary">
            {copy.breadcrumbHome}
          </a>
        </li>
        <li class="inline-flex min-w-0 items-center gap-2">
          <span class="shrink-0 text-primary/50" aria-hidden="true">/</span>
          <h1 class="truncate text-sm font-medium text-ink">{copy.breadcrumbContact}</h1>
        </li>
      </ol>
    </nav>

    <div class="mt-6 grid w-full min-w-0 flex-1 grid-cols-1 items-start gap-8 lg:grid-cols-2 lg:gap-10">
      <article id="branches" class="min-w-0 py-1 sm:py-2">
        <span class="text-sm font-medium text-primary">{copy.branchesEyebrow}</span>
        <h2 class="text-display mt-2 text-start font-black text-ink">
          {copy.branchesHeading}
        </h2>
        <div class="mt-5 rounded-[20px] border border-border bg-surface-soft p-4 sm:mt-6 sm:p-6">
          <h3 class="text-lg font-semibold text-primary">{contact.branch}</h3>
          <dl class="mt-3 flex flex-col gap-2 text-sm text-muted">
            <div>
              <dt class="sr-only">{copy.addressLabel}</dt>
              <dd class="flex min-w-0 items-start gap-2">
                <AssetIcon src="/assets/location.svg" size="sm" class="mt-0.5 shrink-0 text-primary" />
                <a class="min-w-0 break-words" href={clinicMapUrl} target="_blank" rel="noopener noreferrer">{contact.location}</a>
              </dd>
            </div>
            <div>
              <dt class="sr-only">{copy.hoursLabel}</dt>
              <dd class="flex items-start gap-2">
                <AssetIcon src="/assets/clock.svg" size="sm" class="mt-0.5 text-primary" />
                <span>{contact.hours}</span>
              </dd>
            </div>
            {
              clinicLines.map((line) => (
                <div>
                  <dt class="sr-only">{copy.phoneLabel}</dt>
                  <dd class="flex items-start gap-2">
                    <AssetIcon src="/assets/phone.svg" size="sm" class="mt-0.5 text-primary" />
                    <span dir="ltr">{line.phoneDisplay}</span>
                  </dd>
                </div>
              ))
            }
          </dl>
        </div>
        <div class="mt-6 sm:mt-8">
          <SocialLinks locale={locale} heading={copy.followUs} id="form-social" />
        </div>
      </article>

      <article class="order-first min-w-0 rounded-3xl border border-border bg-surface-soft p-4 sm:p-6 lg:order-none" aria-label={copy.pageTitle}>
        <form
          id="contact-form"
          class="flex w-full min-w-0 flex-col gap-4"
          data-locale={locale}
          data-saving={copy.saving}
          data-redirecting={copy.redirecting}
          data-invalid={copy.invalid}
          data-gtm-form="form_landing"
        >
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            <label class="grid gap-2 text-sm text-muted">
              {copy.phone}
              <input
                class={fieldClass}
                name="phone"
                type="tel"
                inputmode="numeric"
                autocomplete="tel"
                pattern="05[0-9]{8}"
                placeholder={copy.phonePlaceholder}
                required
                dir="ltr"
              />
            </label>
            <label class="grid gap-2 text-sm text-muted">
              {copy.name}
              <input
                class={fieldClass}
                name="name"
                type="text"
                autocomplete="name"
                minlength="3"
                maxlength="100"
                placeholder={copy.namePlaceholder}
                required
              />
            </label>
          </div>

          <label class="grid gap-2 text-sm text-muted">
            {copy.service}
            <select class={fieldClass} name="department" required>
              <option value="">{copy.servicePlaceholder}</option>
              {copy.departments.map((department) => (
                <option value={department.value}>{department.label}</option>
              ))}
            </select>
          </label>

          <label class="grid gap-2 text-sm text-muted">
            {copy.message}
            <textarea class={fieldClass} name="message" rows="5" maxlength="500" placeholder={copy.messagePlaceholder}></textarea>
          </label>

          <label class="sr-only" aria-hidden="true">
            Website
            <input name="website" type="text" tabindex="-1" autocomplete="off" />
          </label>

          <button
            type="submit"
            class="inline-flex min-h-[3.25rem] w-full items-center justify-center gap-2 rounded-full bg-gold-gradient px-7 text-sm font-bold text-ink-button shadow-[var(--shadow-gold)] transition-transform hover:-translate-y-0.5"
          >
            {copy.submit}
            <AssetIcon src="/assets/whatsapp.svg" size="sm" />
          </button>
          <p data-form-status class="min-h-5 text-sm text-muted" role="status" aria-live="polite"></p>
        </form>
      </article>
    </div>

    <p class="mt-8 text-center text-xs text-muted">
      <a href={copy.homeHref} class="font-bold text-primary transition-colors hover:underline">
        {copy.goFullSite}
      </a>
    </p>
  </div>
</section>

<script>
  import {
    buildBookingWhatsAppMessage,
    buildWhatsAppUrl,
    clinicContact,
    clinicLineFromDepartment,
  } from '../../data/contact';
  import { saveCustomerLead } from '../../lib/customer-leads';
  import { GtmEvents, pushGtmEvent } from '../../lib/gtm';

  const bindFormLanding = () => {
    const form = document.getElementById('contact-form');
    if (!(form instanceof HTMLFormElement) || form.dataset.bound === 'true') return;
    form.dataset.bound = 'true';

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const status = form.querySelector<HTMLElement>('[data-form-status]');
      const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (!form.reportValidity()) {
        pushGtmEvent(GtmEvents.formError, { form_id: 'form_landing', method: 'whatsapp' });
        if (status) status.textContent = form.dataset.invalid ?? '';
        return;
      }

      const data = new FormData(form);
      const website = String(data.get('website') ?? '');
      if (website.trim()) return;

      const name = String(data.get('name') ?? '').trim();
      const phone = String(data.get('phone') ?? '').trim();
      const department = String(data.get('department') ?? '').trim();
      const message = String(data.get('message') ?? '').trim();
      const locale = form.dataset.locale === 'en' ? 'en' : 'ar';
      const whatsappMessage = buildBookingWhatsAppMessage({
        name,
        phone,
        department,
        branch: clinicContact.branch,
        message,
      });
      const whatsappUrl = buildWhatsAppUrl(whatsappMessage, clinicLineFromDepartment(department));
      const whatsappWindow = window.open('about:blank', '_blank');
      if (whatsappWindow) whatsappWindow.opener = null;

      pushGtmEvent(GtmEvents.formSubmit, { form_id: 'form_landing', method: 'whatsapp' });
      if (submit) submit.disabled = true;
      if (status) status.textContent = form.dataset.saving ?? '';

      void (async () => {
        try {
          await saveCustomerLead({
            name,
            phone,
            department,
            service: department,
            locale,
            consent: true,
            website,
          });
        } catch {
          /* Still open WhatsApp so the clinic receives the request. */
        }
        if (status) status.textContent = form.dataset.redirecting ?? '';
        if (whatsappWindow) whatsappWindow.location.href = whatsappUrl;
        else window.location.href = whatsappUrl;
        if (submit) submit.disabled = false;
      })();
    });
  };

  document.addEventListener('astro:page-load', bindFormLanding);
</script>
