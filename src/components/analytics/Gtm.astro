---
import { isGtmConfigured } from '../../lib/gtm';
---

{isGtmConfigured && (
  <script>
    import {
      ANALYTICS_CONSENT_GRANTED_EVENT,
      readAnalyticsConsent,
    } from '../../lib/analytics/consent';
    import {
      GTM_ID,
      GtmEvents,
      isGtmEnabled,
      loadGtmContainer,
      pushGtmEvent,
      resolveContactEvent,
      resolveCtaLocation,
    } from '../../lib/gtm';

    const scheduleLoad = () => {
      if (!isGtmEnabled()) return;
      const run = () => loadGtmContainer(GTM_ID);
      const idle = (window as Window & {
        requestIdleCallback?: (cb: () => void, opts?: { timeout: number }) => number;
      }).requestIdleCallback;
      if (typeof idle === 'function') {
        idle(run, { timeout: 2_000 });
      } else {
        globalThis.setTimeout(run, 1);
      }
    };

    if (readAnalyticsConsent() === 'granted') scheduleLoad();
    window.addEventListener(ANALYTICS_CONSENT_GRANTED_EVENT, scheduleLoad);

    const bindContactTracking = () => {
      if (document.documentElement.dataset.gtmContactBound === 'true') return;
      document.documentElement.dataset.gtmContactBound = 'true';

      document.addEventListener(
        'click',
        (event) => {
          if (!isGtmEnabled()) return;
          const target = event.target;
          if (!(target instanceof Element)) return;

          const link = target.closest('a[href]');
          if (!(link instanceof HTMLAnchorElement)) return;

          const eventName = resolveContactEvent(link.href);
          if (!eventName) return;

          pushGtmEvent(eventName, {
            link_url: link.href,
            link_text: (link.textContent || '').trim().slice(0, 80),
            cta_location: resolveCtaLocation(link),
            contact_method:
              eventName === GtmEvents.contactWhatsapp
                ? 'whatsapp'
                : eventName === GtmEvents.contactCall
                  ? 'call'
                  : 'email',
          });
        },
        true,
      );
    };

    bindContactTracking();
    document.addEventListener('astro:page-load', bindContactTracking);
  </script>
)}
