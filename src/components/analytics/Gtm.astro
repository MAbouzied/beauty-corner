---
import { GTM_ID, isGtmEnabled } from '../../lib/gtm';
---

{isGtmEnabled && (
  <>
    <!-- Google Tag Manager -->
    <script is:inline define:vars={{ GTM_ID }}>
      (function (w, d, s, l, i) {
        w[l] = w[l] || [];
        w[l].push({
          'gtm.start': new Date().getTime(),
          event: 'gtm.js',
          gtm_container_id: i,
        });
        var f = d.getElementsByTagName(s)[0];
        var j = d.createElement(s);
        var dl = l != 'dataLayer' ? '&l=' + l : '';
        j.async = true;
        j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
        f.parentNode.insertBefore(j, f);
      })(window, document, 'script', 'dataLayer', GTM_ID);
    </script>
    <!-- End Google Tag Manager -->
  </>
)}

<script>
  import { GtmEvents, isGtmEnabled, pushGtmEvent, resolveContactEvent, resolveCtaLocation } from '../../lib/gtm';

  const bindContactTracking = () => {
    if (!isGtmEnabled) return;
    if (document.documentElement.dataset.gtmContactBound === 'true') return;
    document.documentElement.dataset.gtmContactBound = 'true';

    document.addEventListener(
      'click',
      (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;

        const link = target.closest('a[href]');
        if (!(link instanceof HTMLAnchorElement)) return;

        const eventName = resolveContactEvent(link.href);
        if (!eventName) return;

        pushGtmEvent(eventName, {
          link_url: link.href,
          link_text: (link.textContent || '').trim().slice(0, 80),
          cta_location: resolveCtaLocation(link),
          contact_method:
            eventName === GtmEvents.contactWhatsapp
              ? 'whatsapp'
              : eventName === GtmEvents.contactCall
                ? 'call'
                : 'email',
        });
      },
      true,
    );
  };

  bindContactTracking();
  document.addEventListener('astro:page-load', bindContactTracking);
</script>
