---
import type { FaqItem } from '../../data/faq';
import type { Locale } from '../../lib/i18n/localize';
import { isEnglish, ui } from '../../lib/i18n/localize';
import AssetIcon from '../ui/AssetIcon.astro';
import SectionHeading from '../ui/SectionHeading.astro';

export interface Props {
  items: readonly FaqItem[];
  locale?: Locale;
}

const { items, locale = 'ar' } = Astro.props;
const en = isEnglish(locale);
const copy = ui(locale);
---

<section class="bg-surface py-12 sm:py-24" aria-labelledby="faq-heading">
  <div class="page-container">
    <div id="faq-heading">
      <SectionHeading
        eyebrow={en ? copy!.faq.eyebrow : 'الأسئلة الشائعة'}
        title={en ? copy!.faq.title : 'أسئلة يتكرر طرحها'}
      />
    </div>
    <div class="mx-auto mt-8 max-w-3xl space-y-3 sm:mt-10">
      {items.map((item) => (
        <details class="group overflow-hidden rounded-[var(--radius-card)] border border-border bg-surface-soft px-4 py-3 sm:px-5 sm:py-4">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-start text-sm font-bold text-ink sm:text-base [&::-webkit-details-marker]:hidden">
            <span>{item.question}</span>
            <AssetIcon
              src="/assets/plus.svg"
              size="sm"
              class="shrink-0 transition-transform duration-300 group-open:rotate-45"
            />
          </summary>
          <p class="pt-3 text-sm leading-7 text-muted sm:text-base sm:leading-8">{item.answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>
