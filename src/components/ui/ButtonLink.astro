---
export interface Props {
  href: string;
  variant?: 'gold' | 'outline';
  size?: 'sm' | 'lg';
  class?: string;
  target?: '_blank' | '_self';
  rel?: string;
}

const {
  href,
  variant = 'gold',
  size = 'sm',
  class: className = '',
  target,
  rel = target === '_blank' ? 'noopener noreferrer' : undefined,
} = Astro.props;
const variants = {
  gold: 'bg-gold-gradient text-ink-button shadow-[var(--shadow-gold)] border-transparent',
  outline: 'border-border bg-surface text-ink hover:border-primary/40',
} as const;
const sizes = {
  sm: 'min-h-10 px-5 text-xs',
  lg: 'min-h-[3.25rem] px-7 text-base',
} as const;
---

<a
  href={href}
  target={target}
  rel={rel}
  class:list={[
    'inline-flex items-center justify-center gap-2 rounded-full border font-bold whitespace-nowrap transition-transform hover:-translate-y-0.5',
    variants[variant],
    sizes[size],
    className,
  ]}
>
  <slot />
</a>
