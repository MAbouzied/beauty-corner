---
export interface Props {
  text: string;
}

const { text } = Astro.props;
---

<span class="inline-flex max-w-full items-center justify-center rounded-full border border-primary/20 bg-surface-accent px-3 py-1.5 text-center text-[0.6875rem] leading-4 font-bold tracking-[0.02em] text-balance text-primary sm:px-3.5 sm:tracking-[0.05em]">
  {text}
</span>
