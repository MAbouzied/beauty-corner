{
  "name": "beauty-corner",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "check": "astro check",
    "seo:verify": "node scripts/seo-verify.mjs",
    "test": "node --experimental-strip-types --test \"src/lib/**/*.test.ts\" \"src/modules/**/*.test.ts\"",
    "verify": "npm run check && npm run test && npm run build && npm run seo:verify",
    "preview": "astro preview",
    "preview:cf": "npm run build && wrangler dev --config dist/server/wrangler.json",
    "deploy": "npm run build && wrangler deploy --config dist/server/wrangler.json",
    "astro": "astro",
    "studio:dev": "npm --prefix studio run dev",
    "studio:deploy": "npm --prefix studio run deploy"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.1.7",
    "@astrojs/react": "^6.0.2",
    "@lexical/history": "^0.49.0",
    "@lexical/html": "^0.49.0",
    "@lexical/link": "^0.49.0",
    "@lexical/list": "^0.49.0",
    "@lexical/react": "^0.49.0",
    "@lexical/rich-text": "^0.49.0",
    "@lexical/selection": "^0.49.0",
    "@sanity/client": "^7.26.0",
    "@sanity/image-url": "^2.1.1",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.1.1",
    "astro-portabletext": "^0.13.0",
    "better-auth": "^1.6.25",
    "lexical": "^0.49.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@types/node": "^26.1.2",
    "typescript": "^6.0.3",
    "wrangler": "^4.114.0"
  }
}
